generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum AuthProvider {
  PASSWORD
  GOOGLE
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String?
  provider     AuthProvider @default(PASSWORD)
  googleId     String?      @unique
  emailVerified Boolean     @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions        Session[]
  passwordResets  PasswordReset[]
  workspaces      WorkspaceMember[]
  imports         Import[]
  files           FileObject[]
  jobs            ProcessingJob[]
  commands        ProcessingCommand[]
  exportJobs      ExportJob[]
  auditLogs       AuditLog[]
  emailAccounts   EmailAccount[]

  @@index([email])
}

// Refresh-token sessions. Only a hash of the token is ever stored.
model Session {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workspaces
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      WorkspaceMember[]
  imports      Import[]
  files        FileObject[]
  jobs         ProcessingJob[]
  compilations Compilation[]
  exportJobs   ExportJob[]
  auditLogs    AuditLog[]
  cameras      CameraCalibration[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Ingestion
// ---------------------------------------------------------------------------

enum ImportSource {
  MANUAL_UPLOAD
  VOICE_RECORDER
  EMAIL_CONNECTOR
}

enum Modality {
  DOCUMENT
  INVOICE
  EMAIL
  AUDIO
  IMAGE
  CCTV
  DRONE
  ARCHIVE
  UNKNOWN
}

model Import {
  id          String       @id @default(uuid())
  reference   String       @unique // DSX-2026-000001
  workspaceId String
  userId      String
  source      ImportSource
  label       String?
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     FileObject[]
  jobs      ProcessingJob[]

  @@index([workspaceId, createdAt])
}

enum ScanStatus {
  SKIPPED
  PENDING
  CLEAN
  INFECTED
  ERROR
}

model FileObject {
  id             String   @id @default(uuid())
  reference      String   @unique // DSX-2026-000042
  workspaceId    String
  userId         String
  importId       String?
  originalName   String
  extension      String
  mimeType       String
  detectedMime   String?
  sizeBytes      BigInt
  checksumSha256 String
  storageKey     String   @unique
  storageBucket  String
  modality       Modality @default(UNKNOWN)
  metadata       Json     @default("{}")
  scanStatus     ScanStatus @default(SKIPPED)
  duplicateOfId  String?
  // Set on files extracted from a container (ZIP): the archive and the
  // member path inside it, e.g. `invoices/march/01.pdf`.
  archiveId      String?
  archivePath    String?
  createdAt      DateTime @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  import      Import?          @relation(fields: [importId], references: [id], onDelete: SetNull)
  duplicateOf FileObject?      @relation("FileDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  FileObject[]     @relation("FileDuplicate")
  archive     FileObject?      @relation("ArchiveMember", fields: [archiveId], references: [id], onDelete: Cascade)
  members     FileObject[]     @relation("ArchiveMember")
  items       ProcessingItem[]

  @@index([archiveId])
  @@index([workspaceId, checksumSha256])
  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Processing
// ---------------------------------------------------------------------------

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ItemStatus {
  IMPORTED
  QUEUED
  PREPROCESSING
  PROCESSING
  STRUCTURING
  COMPILED
  COMPLETED
  FAILED
  CANCELLED
}

model ProcessingJob {
  id          String    @id @default(uuid())
  reference   String    @unique // JOB-2026-000007
  workspaceId String
  userId      String
  importId    String?
  name        String
  status      JobStatus @default(QUEUED)
  totalItems  Int       @default(0)
  doneItems   Int       @default(0)
  failedItems Int       @default(0)
  options     Json      @default("{}")
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  import    Import?          @relation(fields: [importId], references: [id], onDelete: SetNull)
  items     ProcessingItem[]
  commands  ProcessingCommand[]

  @@index([workspaceId, createdAt])
  @@index([status])
}

model ProcessingItem {
  id          String     @id @default(uuid())
  jobId       String
  fileId      String
  position    Int
  modality    Modality
  status      ItemStatus @default(QUEUED)
  attempts    Int        @default(0)
  stage       String?
  progress    Int        @default(0)
  error       String?
  durationMs  Int?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  job     ProcessingJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  file    FileObject         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  results ProcessingResult[]

  @@unique([jobId, position])
  @@index([jobId, status])
}

enum ResultOrigin {
  INITIAL
  REPROCESS
  COMMAND
}

model ProcessingResult {
  id           String       @id @default(uuid())
  itemId       String
  version      Int          @default(1)
  origin       ResultOrigin @default(INITIAL)
  supersedesId String?      @unique
  engine       String // e.g. invoice.v1
  engineVersion String
  demo         Boolean      @default(false)
  data         Json // structured, human-renderable payload
  measurements Json         @default("[]")
  warnings     Json         @default("[]")
  confidence   Float?
  createdAt    DateTime     @default(now())

  item       ProcessingItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supersedes ProcessingResult? @relation("ResultVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy ProcessingResult? @relation("ResultVersion")
  records    CompilationRecord[]

  @@index([itemId, version])
}

// ---------------------------------------------------------------------------
// Compilation
// ---------------------------------------------------------------------------

model Compilation {
  id          String   @id @default(uuid())
  workspaceId String
  modality    Modality
  name        String
  columns     Json     @default("[]")
  recordCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  records    CompilationRecord[]
  exportJobs ExportJob[]

  @@unique([workspaceId, modality])
}

model CompilationRecord {
  id            String   @id @default(uuid())
  compilationId String
  resultId      String
  sourceRef     String // originating file reference (DSX-...)
  rowKey        String // stable key per logical row, e.g. DSX-000001#vehicle-3
  data          Json
  geometry      Json? // GeoJSON geometry when spatial
  removed       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  compilation Compilation      @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  result      ProcessingResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([compilationId, rowKey])
  @@index([compilationId, removed])
}

// ---------------------------------------------------------------------------
// Command assistant + audit
// ---------------------------------------------------------------------------

enum CommandStatus {
  PENDING
  EXECUTED
  REJECTED
  FAILED
}

model ProcessingCommand {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  jobId       String?
  input       String
  operation   Json // parsed, structured, validated operation
  status      CommandStatus @default(PENDING)
  response    Json?
  error       String?
  createdAt   DateTime      @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?
  userId      String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Export
// ---------------------------------------------------------------------------

enum ExportFormat {
  XLSX
  CSV
  PDF
  JSON
  GEOJSON
  TXT
  DOCX
}

enum ExportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model ExportJob {
  id            String       @id @default(uuid())
  reference     String       @unique
  workspaceId   String
  userId        String
  compilationId String
  format        ExportFormat
  status        ExportStatus @default(QUEUED)
  options       Json         @default("{}")
  storageKey    String?
  sizeBytes     BigInt?
  rowCount      Int?
  error         String?
  durationMs    Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  compilation Compilation @relation(fields: [compilationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Email connector
// ---------------------------------------------------------------------------

enum EmailProvider {
  GMAIL
  IMAP
}

model EmailAccount {
  id            String        @id @default(uuid())
  workspaceId   String
  userId        String
  provider      EmailProvider
  address       String
  // OAuth/IMAP credentials, encrypted at rest with TOKEN_ENCRYPTION_KEY
  credentials   String
  scopes        String[]      @default([])
  connectedAt   DateTime      @default(now())
  lastUsedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, address])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Camera calibration — required for honest CCTV measurements
// ---------------------------------------------------------------------------

model CameraCalibration {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  // Method: HOMOGRAPHY (4 image<->world point pairs) or SCALE (metres per pixel)
  method      String
  parameters  Json
  units       String   @default("m")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// Counter table backing human-readable references (DSX-YYYY-NNNNNN)
model ReferenceCounter {
  id      String @id // e.g. "DSX:2026"
  current Int    @default(0)
}
