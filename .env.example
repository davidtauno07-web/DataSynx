# ---------------------------------------------------------------------------
# DataSynx environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- API -------------------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173

# --- Database (PostgreSQL) --------------------------------------------------
DATABASE_URL=postgresql://datasynx:datasynx@localhost:5432/datasynx?schema=public

# --- Queue (Redis) ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 compatible: MinIO / AWS S3 / R2) --------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=datasynx
S3_ACCESS_KEY_ID=datasynx
S3_SECRET_ACCESS_KEY=datasynx123
S3_FORCE_PATH_STYLE=true

# --- Auth -------------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=replace-me-with-32-byte-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=replace-me-with-32-byte-random-hex
COOKIE_SECURE=false

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# --- Email connector (Gmail API, read-only scope) ---------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:4000/api/email/gmail/callback

# --- Encryption at rest for stored OAuth tokens (32-byte hex) ---------------
TOKEN_ENCRYPTION_KEY=replace-me-with-32-byte-random-hex

# --- AI service -------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-ai-token
AI_REQUEST_TIMEOUT_MS=600000

# Processing mode: real | demo
# real  -> only genuine model output is returned; missing models => UNAVAILABLE
# demo  -> synthetic results, always tagged demo=true in the API + UI
DATASYNX_MODE=real

# --- AI providers (optional, used by the LLM abstraction) -------------------
LLM_PROVIDER=none            # none | openai | anthropic | ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=

# --- Model runtimes (Python AI service) -------------------------------------
MODEL_CACHE_DIR=./models
DETECTION_MODEL=yolov8n.pt          # ultralytics weights, downloaded on demand
DETECTION_DEVICE=auto               # auto | cpu | cuda
ASR_MODEL=base                      # faster-whisper model size
ASR_DEVICE=auto
OCR_ENGINE=tesseract                # tesseract | none

# --- Uploads / limits -------------------------------------------------------
MAX_UPLOAD_BYTES=2147483648
CLAMAV_HOST=
CLAMAV_PORT=3310
